<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rgcastrof.taskmanager.controller.TaskController">

    <top>
        <VBox spacing="5" styleClass="header">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <Label styleClass="titulo" text="TaskManager" />
            <Label styleClass="subtitulo" text="Gerenciador de Tarefas" />
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>
            <HBox spacing="10">
                <TextField fx:id="searchBar" prefHeight="23.0" prefWidth="550.0" />
                <Button mnemonicParsing="false" text="Buscar" onAction="#searchTask"/>
            </HBox>

            <TableView fx:id="taskTableView" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="taskName" prefWidth="200" text="Título" />
                    <TableColumn fx:id="taskDescription" prefWidth="350" text="Descrição" />
                    <TableColumn fx:id="taskStatus" prefWidth="120" text="Concluída" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#newTask" text="Nova tarefa" />
                <Button onAction="#editTask" text="Editar" />
                <Button onAction="#completeTask" text="Concluir" />
                <Button styleClass="botao-remover" text="Remover" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
